# Next 16 scaffolding: generated in the app dir on every `next dev`, and the
# CLAUDE.md is only "@AGENTS.md". Not repo docs — GMS/CLAUDE.md stays tracked.
/frontend/AGENTS.md
/frontend/CLAUDE.md

# mirror-env.js runtime record of an env swap in effect (machine-local, absolute paths).
# It must stay on disk while a mirror runs, and must never be committed.
backend/.mirror-env-swap-state.json
