PORT=7201
HOSTNAME=0.0.0.0

# Frontend server boot sequence on the real server:
# cd frontend
# npm ci
# npm run env:check:prod
# npm run lint
# npm run build
# npm start

# Primary URLs — these must match the real .env.production, which is what the
# live server runs. This template used to point at raw backend/frontend ports
# over plain http (`http://portal.examplecorp.com:7200`, empty BASE_PATH), which
# is not how this platform is deployed: everything is served through the shared
# Apache vhost over https with a path prefix per system (/gms, /dms, /sso).
# Copying the old values produced a deployment that was both broken (no base
# path means every static asset 404s) and unencrypted with ports exposed
# directly. The template is the file a new environment gets bootstrapped from,
# so it has to be the correct one.
NEXT_PUBLIC_BASE_PATH=/gms
# IANA timezone every time is displayed in (for example Europe/Berlin). Defaults to UTC.
NEXT_PUBLIC_TIMEZONE=UTC
NEXT_PUBLIC_API_BASE_URL=https://portal.examplecorp.com/api/v1
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=https://portal.examplecorp.com
NEXT_PUBLIC_SOCKET_PATH=/socket.io
NEXT_PUBLIC_APP_URL=https://portal.examplecorp.com/gms
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ENABLE_LIVE_DEMO=false

# Local development (no Apache in front) uses the bare ports instead:
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_API_BASE_URL=http://localhost:7200/api/v1
# NEXT_PUBLIC_SOCKET_URL=http://localhost:7200
# NEXT_PUBLIC_APP_URL=http://localhost:7201
# SSO is deployed at https://portal.examplecorp.com/sso (same server, path-routed).
NEXT_PUBLIC_SSO_LOGIN_URL=https://portal.examplecorp.com/sso/bridge/gms/start
