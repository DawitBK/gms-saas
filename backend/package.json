{
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "setup:env": "node ../tools/setup-env.js backend",
    "dev": "nodemon --watch src --ext ts,js,json --exec node scripts/run-with-env.js development src/main.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=4096 scripts/run-with-env.js production dist/main.js",
    "start:mirror": "node --max-old-space-size=4096 scripts/run-with-env-mirror.js dist/main.js",
    "outbox:worker": "node --max-old-space-size=4096 scripts/run-with-env.js production dist/bin/outbox.worker.js",
    "outbox:worker:mirror": "node --max-old-space-size=4096 scripts/run-with-env-mirror.js dist/bin/outbox.worker.js",
    "outbox:redact-otps": "node scripts/run-with-env.js development scripts/redact-outbox-otps.ts",
    "outbox:redact-otps:prod": "node scripts/run-with-env.js production scripts/redact-outbox-otps.ts",
    "outbox:worker:dev": "nodemon --watch src --ext ts,js,json --exec node scripts/run-with-env.js development src/bin/outbox.worker.ts",
    "test": "jest --config jest.config.js --no-cache --json --outputFile=test-results.json",
    "test:openapi-coverage": "node scripts/validate-openapi-coverage.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage --forceExit --no-cache",
    "migrate": "node scripts/run-sequelize-cli.js development db:migrate",
    "migrate:prod": "node scripts/run-sequelize-cli.js production db:migrate",
    "migrate:mirror": "node scripts/run-sequelize-cli-mirror.js db:migrate",
    "migrate:undo": "node scripts/run-sequelize-cli.js development db:migrate:undo",
    "migrate:undo:prod": "node scripts/run-sequelize-cli.js production db:migrate:undo",
    "migrate:undo:all": "node scripts/run-sequelize-cli.js development db:migrate:undo:all",
    "seed:core": "node scripts/run-sequelize-cli.js development db:seed --seed 000-core-seeder.js",
    "seed:mirror:core": "node scripts/run-sequelize-cli-mirror.js db:seed --seed 000-core-seeder.js",
    "seed:undo": "node scripts/run-sequelize-cli.js development db:seed:undo:all",
    "seed:undo:prod": "node scripts/run-sequelize-cli.js production db:seed:undo:all",
    "seed:time-slots": "node scripts/seed-time-slots.js development",
    "seed:time-slots:prod": "node scripts/seed-time-slots.js production",
    "db:audit:org": "node scripts/audit-org-integrity.js",
    "db:hard-reset": "node scripts/hard-reset-dev-db.js",
    "db:fresh": "npm run db:wipe && npm run migrate && node scripts/run-sequelize-cli.js development db:seed --seed 000-core-seeder.js",
    "db:wipe": "node scripts/wipe-db.js",
    "db:wipe:prod": "node scripts/run-with-env.js production scripts/wipe-db.js",
    "db:fresh:prod": "npm run db:wipe:prod && npm run migrate:prod && node scripts/run-sequelize-cli.js production db:seed --seed 000-core-seeder.js",
    "db:prepare-fresh": "node scripts/prepare-fresh.js",
    "seed:demo": "node scripts/run-sequelize-cli.js development db:seed --seed 003-demo-data-seeder.js",
    "simulate": "node scripts/simulation-engine.js",
    "simulate:cleanup": "node -e \"process.env.SIMULATION_CLEANUP='true'; require('./scripts/simulation-engine.js')\"",
    "env:check:prod": "node scripts/check-env-presence.js production",
    "db:backup": "node scripts/db-backup.js development",
    "db:backup:prod": "node scripts/db-backup.js production",
    "pm2:start": "pm2 start deploy/ecosystem.config.js",
    "pm2:stop": "pm2 stop gms-api gms-outbox",
    "pm2:restart": "pm2 restart gms-api gms-outbox",
    "pm2:reload": "pm2 reload gms-api gms-outbox",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "deploy:manual": "npm run build && pm2 reload gms-api || pm2 start deploy/ecosystem.config.js --only gms-api",
    "webpush:keygen": "node -e \"const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey);\""
  },
  "dependencies": {
    "@sentry/node": "^10.46.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "undici": "^7.16.0",
    "web-push": "^3.6.7",
    "xlsx": "file:../vendor/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
