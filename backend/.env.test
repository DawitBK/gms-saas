# Isolated test environment — never point at gmsdev or production databases.
NODE_ENV=test
# P2-7: was 5001 — the pre-7xxx port scheme. Exactly the stale-committed-template
# class that has already bitten frontend/.env.example.
# Harmless in practice (the suite drives the app through supertest rather than a
# listening socket) but it is the file people copy from.
PORT=7200
HOST=127.0.0.1

CLIENT_URL=http://localhost:7201
CORS_ALLOWED_ORIGINS=http://localhost:7201
ENABLE_API_DOCS=false
ENABLE_PUBLIC_METRICS_ROUTE=false
API_BASE_PATH=/api/v1
SOCKET_PATH=/socket.io

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Development password of the isolated `gms_test` database: set it to match the local PostgreSQL role (or drop the line and supply DB_PASSWORD from the environment).
DB_PASSWORD=change-me-dev-password
DB_NAME=gms_test

# Use Redis DB index 1 in tests to avoid clobbering dev keys on a shared instance.
REDIS_URL=redis://127.0.0.1:6379/1

JWT_SECRET=ci-test-secret-that-is-at-least-32-chars
JWT_REFRESH_SECRET=ci-refresh-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FROM_EMAIL=no-reply@test.local
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

RATE_LIMIT_GLOBAL_MAX=100000
RATE_LIMIT_AUTH_MAX=100000
RATE_LIMIT_CRITICAL_MAX=100000
RATE_LIMIT_USER_MAX=100000

SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=false

ENABLE_QUEUE_WORKERS=false
ENABLE_OUTBOX_POLLING=false
ENABLE_UNIFI_ACCESS_POLLING=false
