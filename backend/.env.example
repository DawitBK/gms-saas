PORT=7200
HOST=0.0.0.0
NODE_ENV=production

# Previous local/dev setup kept for reference:
# HOST=127.0.0.1
# NODE_ENV=development
# CLIENT_URL=http://localhost:7201
# CORS_ALLOWED_ORIGINS=
# ENABLE_API_DOCS=true
# ENABLE_PUBLIC_METRICS_ROUTE=true
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=gms_db
# REDIS_URL=redis://localhost:6379
# UNIFI_ACCESS_BASE_URL=
# UNIFI_ACCESS_API_KEY=
# UNIFI_ACCESS_TLS_REJECT_UNAUTHORIZED=true
# ENABLE_UNIFI_ACCESS_POLLING=false

# Local machine using production-mode env:
# - Prefer `npm run migrate:prod`, `npm run seed:prod`, and `npm run seed:time-slots:prod`
# - Do not mix `migrate` with `migrate:prod` unless `.env.development` and `.env.production` point at different DBs on purpose
# - Do not run both `npm start` and `npm run outbox:worker` if this file keeps `ENABLE_QUEUE_WORKERS=true` and `ENABLE_OUTBOX_POLLING=true`
# - If you want a split API plus worker setup instead, set `ENABLE_QUEUE_WORKERS=false` and `ENABLE_OUTBOX_POLLING=false` here, then run `npm run outbox:worker` separately

# Safe shutdown and restart
# Why:
# - This local production-mode file points at the local `gmsdev` database.
# - The API process already runs queue workers and outbox polling when
#   `ENABLE_QUEUE_WORKERS=true` and `ENABLE_OUTBOX_POLLING=true`.
# - Starting `npm run outbox:worker` at the same time would duplicate background work.
# - Mixing `migrate` and `migrate:prod` on this machine can hit the same DB and create confusion.
#
# Safe sequence from repo root:
# 1. Stop the running backend terminal with Ctrl+C.
# 2. Stop the running frontend terminal with Ctrl+C.
# 3. Restart backend first:
#    cd backend
#    npm run build
#    npm run migrate:prod
#    npm start
# 4. Restart frontend in a second terminal:
#    cd frontend
#    npm run build
#    npm start
#
# Do not run `npm run outbox:worker` with the current settings in this file.

# Run the outbox worker in a second terminal or service when
# ENABLE_QUEUE_WORKERS=false and ENABLE_OUTBOX_POLLING=false:
# cd backend
# npm run outbox:worker

CLIENT_URL=https://portal.examplecorp.com/gms
CORS_ALLOWED_ORIGINS=https://portal.examplecorp.com
ENABLE_API_DOCS=false
ENABLE_PUBLIC_METRICS_ROUTE=false
API_BASE_PATH=/api/v1
SOCKET_PATH=/socket.io

# Real server DB values:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_db_password
DB_NAME=gmsprod

# Local DB block kept for fallback:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=change-me-dev-password
# DB_NAME=gmsdev
# DB_SSL_ENABLED=false
# DB_SSL_REJECT_UNAUTHORIZED=true

REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SSO_INTERNAL_API_KEY=replace_with_a_distinct_shared_key_at_least_32_characters

# Outbound: GMS calling INTO SSO's per-user role-grant API (directive §6.3).
# Must equal SSO backend's SSO_ROLES_API_KEY.
SSO_API_BASE=http://localhost:7300
SSO_ROLES_API_KEY=replace_with_a_different_shared_secret_at_least_32_characters

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=systems@examplecorp.com
SMTP_PASS=replace_with_smtp_password
FROM_EMAIL=systems@examplecorp.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@gms.com
SENDGRID_TIMEOUT_MS=10000

SMS_PROVIDER=
SMS_BASE_URL=
SMS_API_KEY=
SMS_FROM=GMS
SMS_TIMEOUT_MS=10000
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_BASE_URL=https://api.africastalking.com

UNIFI_ACCESS_BASE_URL=https://192.168.6.2:12445
UNIFI_ACCESS_API_KEY=replace_with_unifi_access_api_key
UNIFI_ACCESS_TIMEOUT_MS=10000
UNIFI_ACCESS_MAX_RETRIES=3
UNIFI_ACCESS_TLS_REJECT_UNAUTHORIZED=false
# In production, the server must trust the UniFi controller TLS certificate.
# If webhook delivery from the controller is unavailable, switch to polling:
# ENABLE_UNIFI_ACCESS_POLLING=true
# UNIFI_ACCESS_POLL_INTERVAL_MS=15000
# If webhook mode is used, the callback URL must be reachable by UniFi:
# http://<server-host>:5000/api/v1/integrations/unifi/webhooks/access
UNIFI_ACCESS_QR_MODE=auto
UNIFI_ACCESS_DOOR_MAP={"6th Floor":["480a198e-51f4-4e8e-a710-8fd8b1e58e2c"],"7th Floor":["77fac011-68ed-4a52-ab81-4b7665bbcec3"]}
UNIFI_ACCESS_RESOURCE_MAP={"6th Floor":[{"id":"480a198e-51f4-4e8e-a710-8fd8b1e58e2c","type":"door"}],"7th Floor":[{"id":"77fac011-68ed-4a52-ab81-4b7665bbcec3","type":"door"}]}
UNIFI_ACCESS_WEBHOOK_SECRET=replace_with_unifi_webhook_secret
ENABLE_UNIFI_ACCESS_POLLING=true
UNIFI_ACCESS_POLL_INTERVAL_MS=15000

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
METRICS_ENABLED=true

RATE_LIMIT_GLOBAL_MAX=10000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CRITICAL_MAX=100
RATE_LIMIT_USER_MAX=5000
OUTBOX_POLL_INTERVAL_MS=5000
ENABLE_QUEUE_WORKERS=true
ENABLE_OUTBOX_POLLING=true

# Web Push (VAPID) - generate keys with: npm run webpush:keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:systems@examplecorp.com

# P1-10: source addresses allowed to reach this system's INTERNAL service-to-service
# API, checked BEFORE the shared key is compared. Every real caller is another
# Example Corp backend on this same host, so loopback-only matches the actual
# topology and removes remote brute-forcing of the static key entirely.
# Comma-separated. "*" disables the check -- never in production.
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# Which upstream hop may set X-Forwarded-For (see app.ts). Apache and every
# Node process run on the same internal server, so loopback is correct here.
TRUST_PROXY=loopback

# Platform licence (docs/operations/PLATFORM-LICENSING.md). All optional; the defaults below apply when a line is absent.
# The licence is issued centrally in SSO and fetched here. No licence record in SSO means no enforcement, and
# an unreachable SSO never blocks anyone (the last verified token is kept in memory and in LICENSE_DATA_DIR).
#   LICENSE_ENFORCEMENT  enforce (default) | warn (compute and log, never block) | off (do not even fetch)
#   LICENSE_SSO_URL      the SSO BACKEND (loopback), not the public /sso URL. The mirror uses http://127.0.0.1:9300
#   LICENSE_POLL_SECONDS how often to ask SSO for the current token (10..86400)
#   LICENSE_ISSUER       optional: pin the expected token issuer; unset = whatever SSO's discovery document reports
#   LICENSE_DATA_DIR     optional: where the last good token is kept (default <backend>/data/license, git-ignored)
LICENSE_ENFORCEMENT=enforce
LICENSE_SSO_URL=http://127.0.0.1:7300
LICENSE_POLL_SECONDS=300
# LICENSE_ISSUER=
# LICENSE_DATA_DIR=
